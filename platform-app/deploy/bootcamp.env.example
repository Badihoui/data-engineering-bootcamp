# Copier en /srv/bootcamp/bootcamp.env, puis : chmod 600, chown bootcamp:bootcamp
#
# Générer la clé :
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=remplacer-par-une-cle-de-64-caracteres-generee-aleatoirement
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=bootcamp.exemple.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://bootcamp.exemple.fr

# Caddy termine le TLS et transmet X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=1
DJANGO_SSL_REDIRECT=1

# HSTS : à n'activer qu'une fois le domaine définitivement en HTTPS.
# Commencer à 86400 (un jour) avant de passer à 31536000 (un an).
DJANGO_HSTS_SECONDS=0

# La base vit hors du dépôt : un `git reset --hard` ne doit jamais l'effacer.
SQLITE_PATH=/srv/bootcamp/data/db.sqlite3

# Frontend et API partagent le domaine : CORS inutile en production.
CORS_ALLOWED_ORIGINS=https://bootcamp.exemple.fr

# Décommenter pour passer à PostgreSQL (inutile à cette échelle).
# POSTGRES_DB=bootcamp
# POSTGRES_USER=bootcamp
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
